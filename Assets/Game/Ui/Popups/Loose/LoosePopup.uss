.loose-popup__container {
    flex-grow: 1;
    background-color: rgb(61, 66, 75);
    border-width: 6px;
    border-color: rgb(44, 46, 51);
    border-radius: 15px;
    align-items: center;
}

.loose-title {
    font-size: 110px;
    -unity-font-style: bold;
    color: rgb(44, 46, 51);
    margin-top: 65px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Unity/TextMesh%20Pro/Fonts/Maxxi.TTF?fileID=12800000&guid=ce76f9976d2eeab45bddbc1f06b93619&type=3#Maxxi");
}

.loose-buttons-container {
    width: 100%;
    align-items: center;
    justify-content: center;
}

.loose-button-container__score {
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 725px;
    -unity-font-definition: url("project://database/Assets/Unity/TextMesh%20Pro/Fonts/Maxxi.TTF?fileID=12800000&guid=ce76f9976d2eeab45bddbc1f06b93619&type=3#Maxxi");
}

.loose-button-container__score-value {
    font-size: 140px;
    -unity-font-style: bold;
    color: rgb(240, 248, 255);
    -unity-font-definition: url("project://database/Assets/Unity/TextMesh%20Pro/Fonts/Maxxi.TTF?fileID=12800000&guid=ce76f9976d2eeab45bddbc1f06b93619&type=3#Maxxi");
}

.loose-button-container__score-title {
    font-size: 50px;
    color: rgb(44, 46, 51);
    -unity-font-definition: url("project://database/Assets/Unity/TextMesh%20Pro/Fonts/Maxxi.TTF?fileID=12800000&guid=ce76f9976d2eeab45bddbc1f06b93619&type=3#Maxxi");
}

.loose-button-container__placement {
    justify-content: center;
    align-items: center;
    width: 80%;
    height: 500px;
    margin-bottom: 155px;
}

.loose-button {
    width: 100%;
    margin-bottom: 40px;
}

.loose-close-button {
    position: absolute;
    top: 50px;
    right: 50px;
    width: 100px;
    height: 100px;
    background-image: resource('Icons/close');
    -unity-background-image-tint-color: rgb(44, 46, 51);
}
